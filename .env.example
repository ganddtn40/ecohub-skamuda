# SKAMUDA EcoHub - Environment
# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Public: safe to expose to the browser (used by the anon client + middleware).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: required by the seed script (supabase/seed.sql) and admin tasks.
# NEVER expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
